# Copier en .env à la racine du projet sur le VPS (docker compose le lit automatiquement).
# Générer le mot de passe : openssl rand -hex 24
MONGO_ROOT_PASSWORD=

# Rapport IA : renseigner UNE des deux clés (Anthropic prioritaire si les deux sont présentes).
# Sans clé, l'application fonctionne avec un rapport générique.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Clé universelle Emergent (même modèle que la version d'origine par défaut)
EMERGENT_LLM_KEY=
EMERGENT_PROVIDER=gemini
EMERGENT_MODEL=gemini-3.1-pro-preview
