# Copier en .env à la racine du projet sur le VPS (docker compose le lit automatiquement).

# --- Obligatoire ---
# openssl rand -hex 24   (mot de passe MongoDB, lu seulement à la création de la base)
MONGO_ROOT_PASSWORD=
# openssl rand -hex 32   (signe les sessions et chiffre les secrets saisis dans l'admin :
# le changer déconnecte tout le monde et oblige à ressaisir ces secrets)
JWT_SECRET=
# Adresses des comptes administrateurs (séparées par des virgules). Créer le compte sur le site
# avec cette adresse, puis « Mon compte » → « Administration ».
ADMIN_EMAILS=

# --- Rapport IA : UNE des deux clés (Anthropic prioritaire). Sans clé : rapport générique ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EMERGENT_LLM_KEY=
EMERGENT_PROVIDER=gemini
EMERGENT_MODEL=gemini-3.1-pro-preview

# --- E-mails (Brevo, comme Waselni) : codes de confirmation et alertes de fuite ---
# Se configure de préférence dans l'admin (onglet E-mails, avec compteur de quota). Les valeurs
# ci-dessous servent alors de service de SECOURS (limite du jour atteinte ou refus du principal) ;
# sans configuration dans l'admin, elles sont le service principal.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@breachradar.fr
# Limite d'envois par jour du service principal tant qu'elle n'est pas réglée dans l'admin
EMAIL_DAILY_LIMIT=300

# --- Abonnement Premium : se configure dans l'admin (onglet Paiement) ---
# Les valeurs ci-dessous ne servent que si rien n'est enregistré dans l'admin.
# sandbox pour les essais, live en production (identifiants différents dans chaque mode)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Créés par le bouton « Créer les formules » de l'admin
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=
PRICE_MONTHLY_LABEL=4,99 €
PRICE_YEARLY_LABEL=49,99 €
# Webhook https://breachradar.fr/api/billing/paypal/webhook (voir DEPLOIEMENT.md)
PAYPAL_WEBHOOK_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Nombre maximal d'adresses surveillées par abonné
MONITOR_LIMIT=5
